# Copy to server/.env for local development (`cp .env.example .env`).
# The values below are PLACEHOLDERS that are fine for `npm run dev` on your own
# machine. The server refuses to start with NODE_ENV=production unless every
# secret is replaced (see "Production" below).

PORT=4000
DATABASE_URL="postgresql://novaforge:novaforge@localhost:5432/novaforge"

# --- Secrets (required) -------------------------------------------------
# Generate each one independently:   openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
TOTP_ENCRYPTION_KEY="change-me-totp-encryption-key"

# --- WebAuthn relying party (must match the browser origin exactly) ---------
RP_ID="localhost"
RP_NAME="NovaForge"
RP_ORIGIN="http://localhost:5173"

# --- Optional ---------------------------------------------------------------
# Number of reverse proxies in front of the server (e.g. 1 for nginx or Render).
# Leave UNSET when the server is directly exposed: trusting X-Forwarded-For
# there would let clients pick their own IP and bypass per-IP rate limits.
# TRUST_PROXY=1

# Allow anyone to self-register an account. Off by default: accounts are created
# by invitation / enrollment link, and the first administrator with
# `npm run bootstrap:admin`.
# ALLOW_OPEN_REGISTRATION=false

# --- Production (NODE_ENV=production) ---------------------------------------
# Required in addition to non-placeholder secrets of >= 32 characters:
#   IDENTITY_ISSUER=https://your.public.origin
#   IDENTITY_SIGNING_KEY_ID=nf-2026-01
#   IDENTITY_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Generate the signing key (ES256 / P-256, PKCS#8):
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# During key rotation, keep verifying the retired key (public JWKs, JSON array):
#   IDENTITY_PREVIOUS_PUBLIC_KEYS='[{"kty":"EC","crv":"P-256","x":"...","y":"...","kid":"nf-2025-01"}]'
